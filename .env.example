# AIRLOCK environment configuration (example)
# Copy to .env for local development. NEVER commit the real .env.

# Storage backend (sqlite default)
AIRLOCK_DB_PATH=airlock.db

# Registry directories
AIRLOCK_TRUSTED_DIR=registry/trusted
AIRLOCK_QUARANTINE_DIR=registry/quarantine
AIRLOCK_REJECTED_DIR=registry/rejected
AIRLOCK_LKG_DIR=registry/lkg

# Default policy file
AIRLOCK_POLICY_FILE=core/policies/default.yaml

# Backend server
AIRLOCK_GATEWAY_HOST=0.0.0.0
AIRLOCK_GATEWAY_PORT=8000

# Frontend (for CORS)
AIRLOCK_CORS_ORIGINS=http://localhost:3000

# Sandbox
AIRLOCK_SANDBOX_IMAGE=airlock-sandbox:latest
AIRLOCK_SANDBOX_TIMEOUT_SECONDS=30
AIRLOCK_SANDBOX_MEMORY_LIMIT=256m
AIRLOCK_SANDBOX_CPU_LIMIT=0.5
